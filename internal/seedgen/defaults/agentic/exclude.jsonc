//
// Shared platform/agentic exclusions (platform adds Sandbox exclusions separately). The
// common root exclude rules are always applied first.
{
  "keys": [
    // Node SDS references are also regenerated for the target cluster.
    "/registry/secrets/platform-envoy-gateway/node",
    "/registry/daemonsets/platform-envoy-gateway/platform-envoy-gateway"
  ],
  "prefixes": [
    // Domain-specific, non-sensitive SDS references are synthesized by pkg/netsyseed.
    "/registry/secrets/platform-envoy-gateway/bundle-"
  ],
  "substrings": []
}
