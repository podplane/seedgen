// Exclude rules applied only when generating the minimal profile. These are
// composed with the common root exclude rules but are not inherited by the
// recommended profile.
{
  "keys": [],
  "prefixes": [
    // Addon namespaces and namespaced resources that may match broad common
    // Kubernetes include rules.
    "/registry/namespaces/platform-agent-sandbox",
    "/registry/namespaces/platform-envoy-gateway",
    "/registry/namespaces/platform-podplane-operator",
    "/registry/namespaces/platform-secrets-store-csi-driver",
    "/registry/namespaces/platform-secrets-store-csi-provider-",
    "/registry/namespaces/platform-zot-registry",
    "/registry/serviceaccounts/platform-agent-sandbox/",
    "/registry/serviceaccounts/platform-envoy-gateway/",
    "/registry/serviceaccounts/platform-podplane-operator/",
    "/registry/serviceaccounts/platform-secrets-store-csi-driver/",
    "/registry/serviceaccounts/platform-secrets-store-csi-provider-",
    "/registry/serviceaccounts/platform-zot-registry/",
    "/registry/configmaps/platform-envoy-gateway/",
    "/registry/configmaps/platform-podplane-operator/",
    "/registry/configmaps/platform-secrets-store-csi-driver/",
    "/registry/configmaps/platform-secrets-store-csi-provider-",
    "/registry/configmaps/platform-zot-registry/",
    "/registry/roles/platform-envoy-gateway/",
    "/registry/roles/platform-podplane-operator/",
    "/registry/roles/platform-secrets-store-csi-driver/",
    "/registry/roles/platform-secrets-store-csi-provider-",
    "/registry/roles/platform-zot-registry/",
    "/registry/rolebindings/platform-envoy-gateway/",
    "/registry/rolebindings/platform-podplane-operator/",
    "/registry/rolebindings/platform-secrets-store-csi-driver/",
    "/registry/rolebindings/platform-secrets-store-csi-provider-",
    "/registry/rolebindings/platform-zot-registry/",
    "/registry/deployments/platform-agent-sandbox/",
    "/registry/deployments/platform-envoy-gateway/",
    "/registry/deployments/platform-podplane-operator/",
    "/registry/deployments/platform-secrets-store-csi-driver/",
    "/registry/deployments/platform-secrets-store-csi-provider-",
    "/registry/deployments/platform-zot-registry/",
    "/registry/daemonsets/platform-envoy-gateway/",
    "/registry/daemonsets/platform-secrets-store-csi-driver/",
    "/registry/daemonsets/platform-secrets-store-csi-provider-",
    "/registry/services/specs/platform-agent-sandbox/",
    "/registry/services/specs/platform-envoy-gateway/",
    "/registry/services/specs/platform-podplane-operator/",
    "/registry/services/specs/platform-secrets-store-csi-driver/",
    "/registry/services/specs/platform-secrets-store-csi-provider-",
    "/registry/services/specs/platform-zot-registry/",

    // Addon Flux resources under core Flux API groups.
    "/registry/helm.toolkit.fluxcd.io/helmreleases/platform-agent-sandbox/",
    "/registry/helm.toolkit.fluxcd.io/helmreleases/platform-envoy-gateway/",
    "/registry/helm.toolkit.fluxcd.io/helmreleases/platform-podplane-operator/",
    "/registry/helm.toolkit.fluxcd.io/helmreleases/platform-secrets-store-csi-driver/",
    "/registry/helm.toolkit.fluxcd.io/helmreleases/platform-secrets-store-csi-provider-",
    "/registry/helm.toolkit.fluxcd.io/helmreleases/platform-zot-registry/",
    "/registry/helm.toolkit.fluxcd.io/helmreleases/platform-cluster/agent-sandbox-crds",
    "/registry/helm.toolkit.fluxcd.io/helmreleases/platform-cluster/envoy-gateway-crds",
    "/registry/helm.toolkit.fluxcd.io/helmreleases/platform-cluster/podplane-operator-crds",
    "/registry/helm.toolkit.fluxcd.io/helmreleases/platform-cluster/secrets-store-csi-driver-crds",
    "/registry/source.toolkit.fluxcd.io/helmcharts/platform-components/platform-agent-sandbox-",
    "/registry/source.toolkit.fluxcd.io/helmcharts/platform-components/platform-envoy-gateway-",
    "/registry/source.toolkit.fluxcd.io/helmcharts/platform-components/platform-podplane-operator-podplane-operator",
    "/registry/source.toolkit.fluxcd.io/helmcharts/platform-components/platform-secrets-store-csi-driver-",
    "/registry/source.toolkit.fluxcd.io/helmcharts/platform-components/platform-secrets-store-csi-provider-",
    "/registry/source.toolkit.fluxcd.io/helmcharts/platform-components/platform-zot-registry-zot-registry",
    "/registry/source.toolkit.fluxcd.io/helmcharts/platform-components/platform-cluster-agent-sandbox-crds",
    "/registry/source.toolkit.fluxcd.io/helmcharts/platform-components/platform-cluster-envoy-gateway-crds",
    "/registry/source.toolkit.fluxcd.io/helmcharts/platform-components/platform-cluster-podplane-operator-crds",
    "/registry/source.toolkit.fluxcd.io/helmcharts/platform-components/platform-cluster-secrets-store-csi-driver-crds",

    // Recommended Gateway API resources. Gateway API CRDs stay in minimal.
    "/registry/gateway.networking.k8s.io/gatewayclasses/platform-envoy-gateway",
    "/registry/gateway.networking.k8s.io/gateways/platform-envoy-gateway/",
    "/registry/gateway.networking.k8s.io/httproutes/platform-envoy-gateway/",
    "/registry/gateway.networking.k8s.io/referencegrants/platform-",
    "/registry/gateway.envoyproxy.io/",

    // Addon cluster-scoped RBAC and admission resources.
    "/registry/clusterroles/agent-sandbox",
    "/registry/clusterroles/platform-envoy-gateway",
    "/registry/clusterroles/platform-podplane-operator",
    "/registry/clusterroles/platform-podplane-secrets",
    "/registry/clusterroles/platform-secrets-store-csi-driver",
    "/registry/clusterroles/platform-secrets-store-csi-provider-",
    "/registry/clusterrolebindings/agent-sandbox",
    "/registry/clusterrolebindings/platform-envoy-gateway",
    "/registry/clusterrolebindings/platform-podplane-operator",
    "/registry/clusterrolebindings/platform-secrets-store-csi-driver",
    "/registry/clusterrolebindings/platform-secrets-store-csi-provider-",
    "/registry/csidrivers/secrets-store.csi.k8s.io",
    "/registry/validatingadmissionpolicies/platform-deny-editor-shell-",
    "/registry/validatingadmissionpolicybindings/platform-deny-editor-shell-",
    "/registry/mutatingwebhookconfigurations/envoy-gateway-"
  ],
  "substrings": [
    // Addon API groups and CRDs.
    "gateway.envoyproxy.io",
    "agents.x-k8s.io",
    // Secret platform components may appear in cluster-scoped APIService,
    // admission policy, RBAC aggregation, or CRD records whose keys are not
    // namespace-scoped.
    "platform-podplane-operator",
    "platform-podplane-secrets",
    "secretproviderbinding",
    "secretproviderclass",
    "secretproviderkeyspace",
    "secrets-api.podplane.dev",
    "secrets.podplane.dev",
    "secrets-store-csi-driver",
    "secrets-store.csi.x-k8s.io"
  ]
}
