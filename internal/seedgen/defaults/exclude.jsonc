//
// Default exclude rules for `seedgen`. These drop runtime/per-cluster records
// that should not appear in a template snapshot. Exclude is applied after
// include, so a record is kept iff include matches AND exclude does not.
{
  "keys": [
    // apiserver health key
    "/registry/health",
    // recreated by the kube-controller-manager endpoints controller
    "/registry/services/endpoints/default/kubernetes",
    // generated by the OpenBao chart and unique to each installation
    "/registry/secrets/platform-secrets-store-csi-provider-openbao/openbao-csi-provider-hmac-key"
  ],
  "prefixes": [
    // Kubernetes runtime / per-node noise
    "/registry/events/",
    "/registry/leases/",
    "/registry/masterleases/",
    "/registry/pods/",
    "/registry/csinodes/",
    "/registry/minions/",
    "/registry/endpointslices/",
    "/registry/services/endpoints/",
    "/registry/replicasets/",
    "/registry/controllerrevisions/",
    // Workload certificate runtime and cluster-specific public trust state.
    // The operator recreates the ClusterTrustBundle from the externally
    // provisioned, per-cluster CA key.
    "/registry/podcertificaterequests/",
    "/registry/clustertrustbundles/",
    // Recreated by the Secrets Store CSI Driver for each running Pod.
    "/registry/secrets-store.csi.x-k8s.io/secretproviderclasspodstatuses/"
  ],
  "substrings": [
    // kube-system root CA configmap published per-namespace by the apiserver
    "/kube-root-ca.crt"
  ]
}
